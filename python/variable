# Student Details

name = "Shahibha"
age = 19
marks = 78
bonus = 5
attendance = 82.5
is_admin = False
is_teacher = False

print("STUDENT DETAILS")
print("Name:", name)
print("Age:", age)
print("Marks:", marks)
print("Attendance:", attendance)


# 1. ARITHMETIC OPERATORS


a = 10
b = 3

print("Addition:", a + b)
print("Subtraction:", a - b)
print("Multiplication:", a * b)
print("Division:", a / b)
print("Floor Division:", a // b)
print("Modulus:", a % b)
print("Exponent:", a ** b)


# 2. COMPARISON OPERATORS

print("\nCOMPARISON OPERATORS")

print("Equal:", marks == 78)
print("Not Equal:", marks != 50)
print("Greater Than:", marks > 70)
print("Less Than:", marks < 90)
print("Greater Than or Equal:", marks >= 78)
print("Less Than or Equal:", marks <= 80)


# 3. LOGICAL OPERATORS

is_passed = marks >= 40
has_good_score = marks >= 75

print("AND:", is_passed and has_good_score)
print("OR:", is_admin or is_teacher)
print("NOT:", not is_admin)
print("\nLOGICAL OPERATORS")

# 4. ASSIGNMENT OPERATORS

print("\nASSIGNMENT OPERATORS")

print("Original Marks:", marks)

marks += bonus
print("After Adding Bonus:", marks)

marks -= 3
print("After Subtracting:", marks)

marks *= 2
print("After Multiplication:", marks)


# FINAL RESULT

print("\nFINAL RESULT")

print("Student:", name)
print("Final Marks:", marks)
print("Passed:", marks >= 40)
print("Good Score:", marks >= 75)
print("Eligible:", attendance >= 75 and marks >= 40)

